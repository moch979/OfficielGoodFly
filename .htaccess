Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.git|storage|backups|includes|tools)(/|$) - [F,L]

    RewriteRule ^(fr|en)/?$ index.php?lang=$1 [L,QSA]
    RewriteRule ^(fr|en)/program/([a-z0-9\-]+)/?$ program.php?lang=$1&slug=$2 [L,QSA]
    RewriteRule ^program/([a-z0-9\-]+)/?$ program.php?slug=$1 [L,QSA]
    RewriteRule ^(fr|en)/blog/?$ blog.php?lang=$1 [L,QSA]
    RewriteRule ^(fr|en)/blog/([a-z0-9\-]+)/?$ blog.php?lang=$1&slug=$2 [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^blog/([a-z0-9\-]+)/?$ blog.php?slug=$1 [L,QSA]
    RewriteRule ^robots\.txt$ seo.php?file=robots [L]
    RewriteRule ^sitemap\.xml$ seo.php?file=sitemap [L]
</IfModule>

<FilesMatch "^(config(\.local)?\.php|\.gitignore|\.htaccess|DEPLOY\.md|tailwind\.config\.js|.*\.(sql|log|bak|ps1|sh))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
